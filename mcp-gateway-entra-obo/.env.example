ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# The access token presented to the gateway must be issued for this audience.
# Usually this is the Application ID URI of your gateway/API app registration,
# for example: api://11111111-1111-1111-1111-111111111111
GATEWAY_AUDIENCE=api://11111111-1111-1111-1111-111111111111

# Confidential client that is allowed to perform Entra On-Behalf-Of exchange.
GATEWAY_CLIENT_ID=11111111-1111-1111-1111-111111111111
GATEWAY_CLIENT_SECRET=replace-me

# The downstream MCP API scope requested during OBO exchange.
# Usually: api://<mcp-api-app-client-id-or-app-id-uri>/<scope-name>
MCP_SCOPE=api://22222222-2222-2222-2222-222222222222/MCP.Access

# The downstream MCP server validates the exchanged token against this audience.
# Usually this is the Application ID URI or client ID of the MCP API app.
MCP_AUDIENCE=api://22222222-2222-2222-2222-222222222222

PORT=3456
