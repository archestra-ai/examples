# LLM provider to use: "openai" (default), "anthropic", or "gemini"
LLM_PROVIDER="openai"

# Optional: override the default model for the selected provider.
# Defaults: openai=gpt-4o, anthropic=claude-sonnet-4-5-20250929, gemini=gemini-2.5-pro
MODEL_NAME=""

# API keys — only the key for your chosen LLM_PROVIDER is required.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# GitHub Personal Access Token (needed to fetch the demo issue via get_github_issue tool)
GITHUB_TOKEN=""
